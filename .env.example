HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=secunda
MYSQL_USER=secunda
MYSQL_PASSWORD=local_mysql_password
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=5m

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=local_redis_password
REDIS_DB=0

JWT_SECRET=local_only_replace_with_random_secret_at_least_32_bytes
JWT_TTL=24h
