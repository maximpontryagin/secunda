            "properties": {
                "content": {
                    "type": "string",
                    "minLength": 1,
                    "example": "Ready for review"
                }
            }
        },
        "handler.CreateTaskRequest": {
            "type": "object",
            "required": [
                "team_id",
                "title"
            ],
            "properties": {
                "assignee_id": {
                    "type": "integer",
                    "minimum": 1,
                    "x-nullable": true,
                    "example": 2
                },
                "description": {
                    "type": "string",
                    "example": "Add JWT authentication"
                },
                "status": {
                    "type": "string",
                    "default": "todo",
                    "enum": [
                        "todo",
                        "in_progress",
                        "done"
                    ]
                },
                "team_id": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 1
                },
                "title": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 1,
                    "example": "Implement login"
                }
            }
        },
        "handler.CreateTeamRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 1,
                    "example": "Backend"
                }
            }
        },
        "handler.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "invalid_request"
                },
                "message": {
                    "type": "string",
                    "example": "invalid request"
                }
            }
        },
        "handler.FieldChangeResponse": {
            "type": "object",
