            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 254,
                    "example": "bob@example.com"
                },
                "role": {
                    "type": "string",
                    "default": "member",
                    "enum": [
                        "admin",
                        "member"
                    ],
                    "example": "member"
                }
            }
        },
        "handler.LoginRequest": {
            "type": "object",
